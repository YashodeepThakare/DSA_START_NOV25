import java.util.*;
import java.lang.*;
import java.io.*;

// The main method must be in a class named "Main"
class Main {
    public static void prinSubArr(int arr[]){
        for(int k=0;k<arr.length;k++){
         for(int i=k;i<arr.length;i++){
            for(int j=k;j<=i;j++){
                System.out.print(arr[j]+" ");
            }
                        System.out.println();

        }
                                System.out.println();


        }
    }
    public static void main(String[] args) {
        int arr[]={2,4,6,8,10};
        prinSubArr(arr);

    }
}

